{
  "name": "mis-arbitrajes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emuladores": "vite --mode emuladores",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-mis-arbitrajes \"vitest run --config vitest.reglas.config.js\"",
    "emuladores": "firebase emulators:start --project demo-mis-arbitrajes",
    "probar": "npm run build && node scripts/servir-dist.mjs",
    "desplegar:firebase": "firebase deploy --only firestore,auth"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/analytics": "2.0.1",
    "firebase": "13.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "firebase-tools": "15.34.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
